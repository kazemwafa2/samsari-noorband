# =====================================================
# NOORBAND ENVIRONMENT VARIABLES — نمونه
# این فایل را کپی کن به .env.local و مقادیر واقعی خودت را جایگزین کن.
# هرگز .env.local را داخل گیت‌هاب عمومی یا هیچ‌جای عمومی آپلود نکن.
# =====================================================

# GROQ AI — از console.groq.com بگیر
GROQ_API_KEY=

# SUPABASE — از تنظیمات پروژه‌ات در supabase.com بگیر
NEXT_PUBLIC_SUPABASE_URL=https://qsayvdgzzotgmylipwdn.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY


# آدرس سایت (بعد از دیپلوی روی Vercel، آدرس واقعی را اینجا بگذار)
NEXT_PUBLIC_SITE_URL=

# پرداخت زرین‌پال (اختیاری — بدون این، درگاه پرداخت غیرفعال می‌ماند)
ZARINPAL_MERCHANT_ID=

# Push Notification (اختیاری — با دستور: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ایمیل واقعی با Resend (اختیاری — از resend.com بگیر)
RESEND_API_KEY=

# آنالیز و مانیتورینگ (اختیاری — بدون این‌ها هیچ اسکریپتی لود نمی‌شود)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
